pdf-common-crop-run =
    .label = Crop PDF Margins…
pdf-common-crop-settings =
    .label = Crop Margins: Settings…
pdf-common-crop-behavior-heading = After cropping
pdf-common-crop-preserve-annotations =
    .label = Preserve existing annotations (off by default)
pdf-common-crop-preserve-description = Copy Zotero highlights, underlines, comments, notes, images, ink, text annotations, and the attachment note to the cropped PDF. Keep annotation positions and include their visible bounds in the crop. Embedded PDF annotations remain in the file regardless of this setting.
pdf-common-crop-remove-original =
    .label = Remove the original PDF after success (off by default)
pdf-common-crop-remove-description = Move the original attachment and its annotations to Zotero Trash only after the new PDF and requested annotation copies are saved successfully. You can restore the original from Trash. Linked files are not deleted from their external location.
pdf-common-crop-independent-description = These options are independent. If removal is on and preservation is off, Zotero annotations remain only on the original attachment in Trash. Existing links in other notes still point to the original attachment.
pdf-common-crop-python-heading = Python environment
pdf-common-crop-arxiv-stamp =
    .label = Crop the vertical arXiv identifier (on by default)
pdf-common-crop-arxiv-description = Ignore a recognized vertical arXiv identifier in the left margin of the first page when measuring content. Other text and preserved annotations take priority. Turn off to keep the identifier. Scanned stamps without extractable text are not detected.
pdf-common-crop-python-description = Enter the full Python 3.10+ path from setup.command, with PyMuPDF and Pillow installed.
pdf-common-crop-python-setup =
    .label = Configure and verify Python…
